{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "role": { "type": "string" },
    "icon": { "type": "string" },
    "status_action": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "maxLength": 250 },
          "needsIds": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "required": ["text", "needsIds"]
      }
    },
    "unique": { "type": "string", "maxLength": 150 },
    "needsCount": { "type": "integer" }
  },
  "required": ["id", "name", "role", "capabilities"]
}
